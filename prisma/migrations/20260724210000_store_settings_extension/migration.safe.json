        "nullable": true
      }
    },
    {
      "op": "addColumn",
      "table": {
        "schema": "app",
        "name": "user"
      },
      "column": {
        "name": "storefront_logo_media_identifier",
        "type": {
          "name": "varchar",
          "length": 43
        },
        "nullable": true
      }
    },
    {
      "op": "addColumn",
      "table": {
        "schema": "app",
        "name": "user"
      },
      "column": {
