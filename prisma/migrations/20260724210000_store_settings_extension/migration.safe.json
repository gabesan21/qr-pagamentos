          "name": "boolean"
        },
        "nullable": false,
        "default": {
          "kind": "boolean",
          "value": true
        }
      }
    },
    {
      "op": "addColumn",
      "table": {
        "schema": "app",
        "name": "user"
      },
      "column": {
