APP_PORT=3000
# MEDIA_STORAGE_ROOT is fixed in the image at /app/media and is not operator-configurable.
POSTGRES_ADMIN_PASSWORD_FILE=/absolute/path/to/postgres-admin-password
MIGRATOR_PASSWORD_FILE=/absolute/path/to/qr-migrator-password
RUNTIME_PASSWORD_FILE=/absolute/path/to/qr-runtime-password
INITIAL_ADMIN_USERNAME_FILE=/absolute/path/to/initial-admin-username
INITIAL_ADMIN_EMAIL_FILE=/absolute/path/to/initial-admin-email
INITIAL_ADMIN_PASSWORD_FILE=/absolute/path/to/initial-admin-password
SMTP_HOST_FILE=/absolute/path/to/smtp-host
SMTP_PORT_FILE=/absolute/path/to/smtp-port
SMTP_USER_FILE=/absolute/path/to/smtp-user
SMTP_PASSWORD_FILE=/absolute/path/to/smtp-password
SMTP_FROM_FILE=/absolute/path/to/smtp-from
SMTP_TLS_MODE_FILE=/absolute/path/to/smtp-tls-mode
PUBLIC_ORIGIN_FILE=/absolute/path/to/public-origin
TOTP_ENCRYPTION_KEY_FILE=/absolute/path/to/totp-encryption-key
STAGED_SECRETS_DIR=.container-secrets
