{
  "name": "qr-pagamentos-application-frontend",
  "version": "2025.10",
  "description": "Primitive audit, theme, semantic, component and motion resolution for the professional settlement console.",
  "sets": {
    "primitive": {
      "sources": [{ "$ref": "themes.tokens.json" }]
    },
    "semantic": {
      "sources": [{ "$ref": "semantic.tokens.json" }]
    },
    "component": {
      "sources": [{ "$ref": "components.tokens.json" }]
    }
  },
  "modifiers": {
    "theme": {
      "default": "pix-paper",
      "contexts": {
        "pix-paper": [{ "$ref": "themes/pix-paper.tokens.json" }],
        "cashier-daylight": [{ "$ref": "themes/cashier-daylight.tokens.json" }],
        "settlement-sand": [{ "$ref": "themes/settlement-sand.tokens.json" }],
        "midnight-clearing": [{ "$ref": "themes/midnight-clearing.tokens.json" }],
        "vault-blue": [{ "$ref": "themes/vault-blue.tokens.json" }],
        "terminal-amber": [{ "$ref": "themes/terminal-amber.tokens.json" }]
      }
    },
    "motion": {
      "default": "full",
      "contexts": {
        "full": [{ "$ref": "motion/full.tokens.json" }],
        "reduced": [{ "$ref": "motion/reduced.tokens.json" }]
      }
    }
  },
  "resolutionOrder": [
    { "$ref": "#/sets/primitive" },
    { "$ref": "#/modifiers/theme" },
    { "$ref": "#/sets/semantic" },
    { "$ref": "#/sets/component" },
    { "$ref": "#/modifiers/motion" }
  ],
  "$extensions": {
    "com.qr-pagamentos.theme": {
      "defaultLight": "pix-paper",
      "defaultDark": "midnight-clearing"
    }
  }
}
